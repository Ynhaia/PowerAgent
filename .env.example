# 云端模型配置。第三阶段的 Agent 会由后端读取这些变量。
# DeepSeek API Key 填写位置：仅在本项目根目录复制 .env 后填写下一行。
# 不要把 Key 写进源代码、.env.example、前端或提交到 Git。
POWERAGENT_ENV=development
POWERAGENT_LLM_BASE_URL=https://api.deepseek.com
POWERAGENT_LLM_MODEL=deepseek-chat
POWERAGENT_LLM_API_KEY=

# 数据源。默认 mock；只有配置为 http 且填写网关地址后才访问真实只读网关。
POWERAGENT_DATA_SOURCE=mock
POWERAGENT_MOCK_SCENARIO=cw_flow_insufficient

# 真实电厂数据接入仅允许服务端通过 DMZ 内的只读网关访问。
POWERAGENT_PLANT_API_BASE_URL=
POWERAGENT_PLANT_API_TOKEN=
POWERAGENT_PLANT_API_TIMEOUT_SECONDS=5

# PostgreSQL。默认不启用；真实连接串只填写在本地 .env 或部署平台密钥管理中。
# 可选值：mock、http、postgres。postgres 仅用于读取时序、预警和测点字典。
POWERAGENT_DATABASE_URL=
POWERAGENT_TRACE_STORE=memory
